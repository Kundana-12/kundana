android:textStyle="bold" />
<TextView
android:id="@+id/dateTxt"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginVertical="4dp"
android:text="Date"
android:textSize="18sp" />
</LinearLayout>
<LinearLayout
android:id="@+id/editDeleteL"
